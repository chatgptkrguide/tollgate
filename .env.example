# PayPal REST app (developer.paypal.com > Apps & Credentials). Sandbox for the hackathon.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhooks > your webhook > ID (letters and digits only). Needed to verify payment notifications;
# without it every webhook is refused with 503.
PAYPAL_WEBHOOK_ID=

# Claude (console.anthropic.com > API keys). Without it the message box stays off and says why.
ANTHROPIC_API_KEY=

# SQLite file. Leave empty for data/tollgate.db. On Render: a Turso URL (libsql://...) and its token.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
